---
import Header from "../components/Header.astro";
import PhoneTester from "../components/PhoneTester.astro";
import BatchTester from "../components/BatchTester.astro";
import ApiSnippets from "../components/ApiSnippets.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LeadPhone Validator Studio | Telecom Intelligence & Lead Phone Normalizer</title>
    <meta name="description" content="Ultra-fast phone number validation, carrier detection, E.164 normalization, and WhatsApp routing microservice in Go." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />

    <main class="container">
      <div class="hero">
        <div class="hero-badge">
          <span class="badge badge-neutral">Go Microservice Engine</span>
          <span class="hero-subtext">0.4ms Validation Latency</span>
        </div>
        <h1 class="hero-title">
          Stop Losing Inbound Leads to <span class="gradient-text">Malformed Numbers</span>
        </h1>
        <p class="hero-desc">
          Validate global phone formats, recover omitted area codes, detect carriers, and generate direct WhatsApp click-to-chat links before saving to your CRM or marketing automation bot.
        </p>
      </div>

      <PhoneTester />
      <BatchTester />
      <ApiSnippets />
    </main>

    <Footer />
  </body>
</html>

<style>
  .hero {
    text-align: center;
    max-width: 800px;
    margin: 48px auto 24px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    margin-bottom: 20px;
    box-shadow: var(--shadow-sm);
  }

  .hero-subtext {
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--brand-primary);
  }

  .hero-title {
    font-size: 42px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 16px;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 30px;
    }
  }

  .hero-desc {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
</style>
